{
  "name": "@chili-chip/creator",
  "version": "0.16.0",
  "description": "Bitsy-based game creator for Chili Platform, with the citsy runtime",
  "license": "MIT",
  "repository": "github:chili-chip/chili-creator",
  "files": [
    "chili-beat",
    "chili-rpg",
    "citsy",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4310 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docs:screenshots": "playwright test -c playwright.docs.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.9.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
