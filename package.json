{
  "name": "@chili-chip/creator",
  "version": "0.4.0",
  "description": "Bitsy-based game creator for Chili Platform, with the citsy runtime",
  "license": "MIT",
  "repository": "github:chili-chip/chili-creator",
  "files": [
    "editor",
    "citsy",
    "dist"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4310 --strictPort",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "node scripts/check.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.6.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
